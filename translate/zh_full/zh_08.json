[
 {
  "source_id": "0116eba2eaf9b4e7",
  "zh": ".338 曳光弹大弹药盒"
 },
 {
  "source_id": "0157c76e73bf9ea3",
  "zh": "弹匣已满！"
 },
 {
  "source_id": "0198dbf1bd8896d0",
  "zh": "一种特殊装置，用于激活门神器并触发门异常。该异常的去向目前仍在研究中，需要进行实地测试。"
 },
 {
  "source_id": "0285dbdfcd3a42d3",
  "zh": "提供一定的精度与射程，略微降低后坐力，但会使枪械更加笨重。"
 },
 {
  "source_id": "02c4a5d20bbd0ed9",
  "zh": "佩乔尔斯克异常"
 },
 {
  "source_id": "03666783dade0604",
  "zh": "装备配送"
 },
 {
  "source_id": "0617772506aadea0",
  "zh": "按下传感器上的按钮开始测量，并等待测量过程完成。"
 },
 {
  "source_id": "06f4f7de82967e8e",
  "zh": "不可拆卸的中倍率光学瞄准镜。\r\n仅适用于 PSG1。"
 },
 {
  "source_id": "094da9b95fdcee3d",
  "zh": "独头弹"
 },
 {
  "source_id": "0aaab0e5c3a69208",
  "zh": "将套筒完全向后拉，用持枪的手按下 <b>{BTN_Top}</b> 使其挂机。"
 },
 {
  "source_id": "0abf5c079a823051",
  "zh": "带红点分划板的反射式瞄准镜。\r\n可安装到任意导轨上。"
 },
 {
  "source_id": "0b099497b86a0635",
  "zh": "正在登记对象。"
 },
 {
  "source_id": "0b557aca269d7665",
  "zh": "样本容器配送"
 },
 {
  "source_id": "0c9afbc8a06b5d0f",
  "zh": "30 发 SR-25 普通弹药。"
 },
 {
  "source_id": "1096353ab002382d",
  "zh": "跳过开场与训练任务。"
 },
 {
  "source_id": "151b0bef0ff4f53c",
  "zh": "• 靠近导轨后松手即可安装。\r\n• <b>按住 {BTN_Bottom} + {BTN_Trigger}</b> 可开启或关闭。\r\n• 伸手<b>按下 {BTN_Trigger}</b> 可切换红外模式。\r\n• <b>按住 {BTN_Bottom} + {BTN_Grip}</b> 可拆卸。"
 },
 {
  "source_id": "1723cf969fee0a78",
  "zh": "旧军帽"
 },
 {
  "source_id": "17b59525fb06c879",
  "zh": "MP5 旧枪管"
 },
 {
  "source_id": "183509e2b41c428e",
  "zh": "半径无所不能。它创造了这个世界，也创造了我们每一个人。半径洞察一切。它的存在注视着我们。半径自有其设计。它赋予我们目标，并等待我们去实现。半径考验我们。它在我们的路上设下障碍，也给予我们克服它们所需的一切。\r\n我能感受到它的存在。而我正朝着它的中心走去。"
 },
 {
  "source_id": "19b6b12de4e524b1",
  "zh": "而我们已不再是原来的样子。你是异变者。我是你的向导。你看起来还像人类，但我……"
 },
 {
  "source_id": "1a284ab5e32bf587",
  "zh": "旧民警帽"
 },
 {
  "source_id": "1a811c2c306ab0dc",
  "zh": "绿色激光瞄准器"
 },
 {
  "source_id": "1addccb1cb0dfe7b",
  "zh": "/来自除我们以外的所有人/。"
 },
 {
  "source_id": "1c1da2b1d621430c",
  "zh": "30 发 AK-74 与 AKS-74U 曳光弹。"
 },
 {
  "source_id": "1c958100a4d14c72",
  "zh": "M4A1 照门"
 },
 {
  "source_id": "1d29b24a40f7e91a",
  "zh": "/军衔代码"
 },
 {
  "source_id": "1dd7497e52c038ca",
  "zh": "夺取容器"
 },
 {
  "source_id": "1df4b973e0792a77",
  "zh": "经典侦察背心"
 },
 {
  "source_id": "1e149e6ca9f949bb",
  "zh": "清洁油"
 },
 {
  "source_id": "24a542a4e1804158",
  "zh": "大罐"
 },
 {
  "source_id": "2bfd9fc10816ddcf",
  "zh": "我把它接到了下一盏灯上。能用吗？嗯，在这里连指南针都不正常工作。我们没得选，你试试能不能跟着它走。我们在下一个地点碰头。如果你往回走，我也会在通道那里。"
 },
 {
  "source_id": "2e567f9003d235b9",
  "zh": "Vityaz 弹匣"
 },
 {
  "source_id": "36e0763a8d5759ee",
  "zh": "瞄准平滑强度"
 },
 {
  "source_id": "37311f737c7667bf",
  "zh": "旧玩具卡车"
 },
 {
  "source_id": "37a6a8fcfd490776",
  "zh": "还是说，你要与半径切断联系？"
 },
 {
  "source_id": "3969da2809fd19f3",
  "zh": "看吧？我就知道会成功。这就像我们自己专用的撤离装置，只不过这次你没有被撕成碎片！哦……抱歉提起这个。不过话说回来，就算你死了，也只是像什么都没发生一样回来，对吧？我是说，谁不想要那种力量呢？总之，装置表现得很出色。可惜这个神器如此稀有，但我们仍会研究它的潜力。我相信我们一定能找到善加利用的办法。哦，对了……我们在理解半径如何改变事物方面即将取得突破，而我们两人都可能在其中扮演重要的角色。"
 },
 {
  "source_id": "39df4b10021f2067",
  "zh": "M4A1 导轨护木"
 },
 {
  "source_id": "3a47586a47270658",
  "zh": "样本容器配送"
 },
 {
  "source_id": "3bca41aa1f2a3fbb",
  "zh": "地图图例"
 },
 {
  "source_id": "3be9922839c7530c",
  "zh": "此难度面向硬核 VR 老玩家。"
 },
 {
  "source_id": "3c0713cc39dfd3e3",
  "zh": "维护 UNPSC 网络"
 },
 {
  "source_id": "3cc6d1ce27868473",
  "zh": "启动投掷探针，并将其投入门异常。"
 },
 {
  "source_id": "3da200351012f90f",
  "zh": "叙事设计"
 },
 {
  "source_id": "40895bf8cb518b44",
  "zh": "异变不倒翁"
 },
 {
  "source_id": "40fe82ba331b1bbd",
  "zh": "屋顶区"
 },
 {
  "source_id": "41537c463e001b1f",
  "zh": "SVD 旧枪管"
 },
 {
  "source_id": "4283178b8d1d2ed6",
  "zh": "我们遗憾地通知您，您的故乡佩乔尔斯克已不复存在。它在 1987 年消失，被佩乔尔斯克异常——又称「半径」——的出现所吞没。"
 },
 {
  "source_id": "43fac2a55f7c5856",
  "zh": "黑色跳棋套装"
 },
 {
  "source_id": "44b233084f76c486",
  "zh": "100 发 IZh-27 与 Saiga-12 独头弹。"
 },
 {
  "source_id": "46542afcb237f595",
  "zh": "为 5.45x39 口径的 AK 系列和 OTs-14 Groza 步枪提供轻微降噪与中等后坐力补偿。"
 },
 {
  "source_id": "468ae53fb45a6f22",
  "zh": "可惜我不能随时随地冒出来……"
 },
 {
  "source_id": "472a9e2c245ba524",
  "zh": "4x 弹药袋"
 },
 {
  "source_id": "4a8b601060a83155",
  "zh": "手电筒是 UNPSC 探索者装备的重要组成部分，是夜间行动、黑暗空间作业以及与某些神器巢穴互动的必需品。\r\nUNPSC 手电筒的设计使其在佩乔尔斯克异常中仍能完全正常工作。\r\n带口袋夹的 UNPSC 口袋手电筒可手持，也可固定在胸前或任意装备槽位上。\r\n<L3>免持的 UNPSC 头灯可单独佩戴，也可戴在 Sfera、PASGT 或 FAST 头盔上。</L3>"
 },
 {
  "source_id": "4b8bb700297fdf04",
  "zh": "枪身"
 },
 {
  "source_id": "4d6d3bf1491ccd2d",
  "zh": "点射"
 },
 {
  "source_id": "4eaf79f2d0ff523d",
  "zh": "要组装枪械，\r\n首先将枪身放入台钳。"
 },
 {
  "source_id": "51c817094c7244c2",
  "zh": "而他常常为事情最终的结局自责。"
 },
 {
  "source_id": "53a20de3818cef0c",
  "zh": "在潮汐后生效"
 },
 {
  "source_id": "5433ecd065cd9945",
  "zh": "另一名探索者"
 },
 {
  "source_id": "5461220b45bcc3f1",
  "zh": "允许安装配件。\r\n仅适用于带燕尾槽导轨的枪械。"
 },
 {
  "source_id": "54864d5bf057ec87",
  "zh": "而她完全不喜欢事情的发展方向。"
 },
 {
  "source_id": "55cc5833b8b6547e",
  "zh": "• 靠近任意背心上的槽位后松手即可装备。\r\n• 用空闲的手<b>按住 {BTN_Top}</b> 打开玩家信息，查看防弹插板的耐久度。\r\n• <b>按住 {BTN_Bottom} + {BTN_Grip}</b> 可拆卸。"
 },
 {
  "source_id": "56388d883d7b37f0",
  "zh": "旧基尔扎靴"
 },
 {
  "source_id": "596ac53f077c1b74",
  "zh": "喷漆（橄榄色）"
 },
 {
  "source_id": "59932408e2421a93",
  "zh": "探索者平板支架"
 },
 {
  "source_id": "59d852a7fb062838",
  "zh": "此选项启用一个带独立设置的专用桌面摄像机。\r\n它不会影响头显内的画面，但会影响游戏性能。"
 },
 {
  "source_id": "5c446d49106c75fd",
  "zh": "交付畸变传感器"
 },
 {
  "source_id": "5c91e485ff082637",
  "zh": "使用 <b>{BTN_Trigger}</b> 开启/关闭手电筒。"
 },
 {
  "source_id": "5d228960c8d66fae",
  "zh": "将样本容器送到 27 号设施的终端。"
 },
 {
  "source_id": "6097a18524246808",
  "zh": "从终端获取神器容器原型。"
 },
 {
  "source_id": "6208226d078ab76f",
  "zh": "无法开火！安装 <b>{0}</b>\r\n需要使用台钳！"
 },
 {
  "source_id": "62b5c9067c599205",
  "zh": "饼干"
 },
 {
  "source_id": "654e21bd186b84e3",
  "zh": "喷漆（ITR1 砖红色）"
 },
 {
  "source_id": "65bf44a27dec3116",
  "zh": "MP5 导轨护木"
 },
 {
  "source_id": "69048a8e3c951c40",
  "zh": "在标记位置利用静电异常为提供的超级电容器充能。"
 },
 {
  "source_id": "697edbe4acd10b94",
  "zh": "狭窄"
 },
 {
  "source_id": "6a0b55d33a1ff417",
  "zh": "他们拿到了想要的东西，很好。委员会会满意的！"
 },
 {
  "source_id": "6a4683478e44aa15",
  "zh": "喷吐呕吐者"
 },
 {
  "source_id": "6a4bfe1079f4382a",
  "zh": "灯泡神器"
 },
 {
  "source_id": "6ae73f9f9a005898",
  "zh": "固定物品"
 },
 {
  "source_id": "6bd65ac3b98f7446",
  "zh": "藏匿的 Fort-17 说明"
 },
 {
  "source_id": "6cc0f1db7057640c",
  "zh": "异变海绵"
 },
 {
  "source_id": "6d05f365d491988a",
  "zh": "我有更好的选择。那个跟你说话的奇怪身影能改变一切。如果我们到达半径的中心，就能逃离这个地方。不再有半径，也不再有委员会。我确信这一点。"
 },
 {
  "source_id": "6da6ec37bc07d294",
  "zh": "对，就是这样！它现在是你的一部分了。我们在「中间地带」时你得用上它，可能不止用一次。我马上帮你标记通道。"
 },
 {
  "source_id": "6f0107468919a86a",
  "zh": "Benelli M2 手枪握把"
 },
 {
  "source_id": "70d7bd80acdcff49",
  "zh": "PM 弹匣"
 },
 {
  "source_id": "71348be5140025a5",
  "zh": "开发者"
 },
 {
  "source_id": "72fe22ff133fa5a1",
  "zh": "• 靠近 NVD 支臂后松手即可安装。\r\n• 按住 <b>{BTN_Bottom} + {BTN_Trigger}</b> 可开启或关闭。\r\n• 安装在 NVD 支臂上时，按住 <b>{BTN_Trigger}</b> 并向侧面拉动，可将视野切换到另一只眼。\r\n• <b>按住 {BTN_Bottom} + {BTN_Grip}</b> 可拆卸。"
 },
 {
  "source_id": "73abdbc77cd18941",
  "zh": "通过测试以继续任务。"
 },
 {
  "source_id": "74694c07c0684e6a",
  "zh": "容量普通的轻量背包。\r\n可加装额外的弹药袋、枪套和登山扣进行自定义。"
 },
 {
  "source_id": "7483eea780597583",
  "zh": "• 抓住吉他，用持吉他的手<b>按下 {BTN_Top}</b>。\r\n• 用另一只手捏住硬币，上下移动来扫弦。\r\n• 在吉他琴颈一侧的手上<b>按住 {BTN_Trigger}</b>，用摇杆切换和弦。\r\n• 将拨片收纳到吉他面板上的拨片座中。"
 },
 {
  "source_id": "74dd08678521bd75",
  "zh": "耐久度"
 },
 {
  "source_id": "78237acbb72be786",
  "zh": "NVD 支架"
 },
 {
  "source_id": "7884d1b18f72f946",
  "zh": "一条印有启动终端撤离装置代码的腕带。"
 },
 {
  "source_id": "7ac51159d5c9c33d",
  "zh": "次要目标"
 },
 {
  "source_id": "7e00ac424bad71bd",
  "zh": "UNPSC 门神器激活器"
 },
 {
  "source_id": "7e5e35ac55650f5b",
  "zh": "你现在\r\n处于完美健康状态！"
 },
 {
  "source_id": "7f3881b02275fafa",
  "zh": "SR-25 枪口制退器"
 },
 {
  "source_id": "7fe70df8756d264c",
  "zh": "• 放置在标记位置，将其接入 UNPSC 传感器网络。"
 },
 {
  "source_id": "805a93e864e9934a",
  "zh": "创作者摄像机"
 },
 {
  "source_id": "80e7f22e23349e5d",
  "zh": "来电"
 },
 {
  "source_id": "80f0a2ae34deb6eb",
  "zh": "20 世纪 90 年代至 21 世纪初，UNPSC 探索者前往半径执行任务时使用的一套典型服装与装备。"
 },
 {
  "source_id": "823b3d680edfbf78",
  "zh": "一种特殊装置，用于启动生命体的异变过程。\r\n发射前需装配神器容器与超级电容器。"
 },
 {
  "source_id": "826ab0d9ea3ceb36",
  "zh": "握持物品的按键："
 },
 {
  "source_id": "83ed89359f876853",
  "zh": "呕吐者"
 },
 {
  "source_id": "89c76dc97d010866",
  "zh": "再次将枪灯移到导轨下方\r\n然后松手。"
 },
 {
  "source_id": "8a27df284cc766ee",
  "zh": "MP5 护木"
 },
 {
  "source_id": "8af28c9644851d9c",
  "zh": "从终端获取高级神器探测器。"
 },
 {
  "source_id": "8c2d601f2655276f",
  "zh": "隐形巢穴"
 },
 {
  "source_id": "8d8d5a41e13969f6",
  "zh": "好了……就是现在。我们即将做的事可能会改变人类的命运，我毫不夸张。对委员会来说，赌注从未如此之高。我们的新装置能将你的能力赋予普通人，而不必将他们束缚于半径。如果成功，我们就能让人类摆脱疾病、衰老……甚至死亡。"
 },
 {
  "source_id": "8f53a3b30fe291ef",
  "zh": "你还好吗？"
 },
 {
  "source_id": "918e6ce40145cc99",
  "zh": "机枪手拟态怪"
 },
 {
  "source_id": "93b8fae1a46f55f3",
  "zh": "枪械的必要部件，缺少它就无法开火。"
 },
 {
  "source_id": "95883940795f34de",
  "zh": "技术支持"
 },
 {
  "source_id": "95ae337b3077bc39",
  "zh": "一种地方美味，可恢复中等能量。"
 },
 {
  "source_id": "96bf63bce90c1572",
  "zh": "9x39 FMJ 弹药盒"
 },
 {
  "source_id": "979639a48a8f1c63",
  "zh": "在那里，我可以靠完成任务来换取装备。"
 },
 {
  "source_id": "97b19e63aedf7b7a",
  "zh": "没有弹匣！插入弹匣并拉动套筒！"
 },
 {
  "source_id": "9acedb7e07684c90",
  "zh": "SVD 导轨护木"
 },
 {
  "source_id": "9b92e9d7439e6a84",
  "zh": "200 发 AS Val、OTs-14 与 VSS 普通弹药。"
 },
 {
  "source_id": "9c63af77ed0fa11f",
  "zh": "藏匿的 SKS 说明"
 },
 {
  "source_id": "9e4ccf3ab7dc7487",
  "zh": "通道"
 },
 {
  "source_id": "9eb341b9a3ec1212",
  "zh": "从终端获取传感器。"
 },
 {
  "source_id": "a0268d8fa90a365e",
  "zh": "你愿意赐予你的向导完整的人生吗？"
 },
 {
  "source_id": "a0c306748f41d5e7",
  "zh": "G3 伸缩枪托"
 },
 {
  "source_id": "a0d9f235469aefc8",
  "zh": "注意！站住！你是……获准进入 UNPSC 探索者设施。"
 },
 {
  "source_id": "a18ade7b2bcd911a",
  "zh": "Saiga-12 枪口制退器"
 },
 {
  "source_id": "a38d61ed73eff8fd",
  "zh": "IZh-27 6x 弹带（右）"
 },
 {
  "source_id": "a3f8facdd83492c5",
  "zh": "从终端获取投掷探针。"
 },
 {
  "source_id": "a418c1feadf416c2",
  "zh": "你可以用另一个弹匣敲击\r\n来卸下 AK 系列的弹匣。"
 },
 {
  "source_id": "a519b364e6edf795",
  "zh": "• 用空闲的手<b>按下 {BTN_Trigger}</b>，拉动顶部将其展开。\r\n• 快速穿过静电异常以引发放电，为其充能。"
 },
 {
  "source_id": "a5b79f5961a2874f",
  "zh": "神器"
 },
 {
  "source_id": "a63e173a3c85e253",
  "zh": "藏匿的 Bizon"
 },
 {
  "source_id": "a9423df2454c1e27",
  "zh": "藏匿的 SKS"
 },
 {
  "source_id": "a96207ef4d53401a",
  "zh": "拒绝一切人性之物，本身就是非常人性的事。"
 },
 {
