 },
 {
  "source_id": "8cca7bc934207ee8",
  "zh": "创作者相机已启用"
 },
 {
  "source_id": "8dd668521a595f69",
  "zh": "可让 SKS 安装 Bizon、Vityaz、Saiga-12 或 AKS-74U 枪托。"
 },
 {
  "source_id": "8e15db0625527d31",
  "zh": "你已死于"
 },
 {
  "source_id": "8e8f51ee444650c4",
  "zh": "半自动狙击步枪的改进版本，口径 7.62×51。具备高精度和快速射击能力。为射手设计，既适合城市交战，也适合开阔地带作战。"
 },
 {
  "source_id": "8efd63cde263e7f7",
  "zh": "委员会知道我们的向导，并把他们视为威胁。他们在这件事上对我们撒谎。你的向导不是你的想象，不是失忆的症状，也不是重生的副作用。珍惜他们。倾听他们。千万不要抛弃他们！我毁掉了我的向导。我失去了自己重要的一部分。现在我再也没法抵达半径的中心了……\r\n阿列克谢"
 },
 {
  "source_id": "906d6ec6e1e86d8f",
  "zh": "看看你们所谓的黄金球体吧。"
 },
 {
  "source_id": "92975ae0f0cc1025",
  "zh": "领取放大器"
 },
 {
  "source_id": "92e67c4b204f702f",
  "zh": "注视点渲染强度"
 },
 {
  "source_id": "9357ac7c3333a602",
  "zh": "好吧，但愿你已经准备好了。作为探索者，你的职责是深入佩乔尔斯克异常，收集神器，完成任务，并发现各种值得关注的目标。听起来或许平淡，但相信我，这一切都是为了我们的终极目标。你不只是在随意采集样本。这关乎全人类！不过这些我们稍后再谈。现在，你已被授予第一个安全等级。恭喜！"
 },
 {
  "source_id": "965fb2ddf63d60f4",
  "zh": "领取"
 },
 {
  "source_id": "988cce7c56665e51",
  "zh": "M4A1 导气座"
 },
 {
  "source_id": "9931b4e04008fef6",
  "zh": "我们准备了一台能激活特殊神器的装置。你需要在半径内对它进行实地测试。请记住，激活必须在特定地点进行。否则数据就会失效。"
 },
 {
  "source_id": "9af83a79ab669091",
  "zh": "好了，我们该继续前进了。你需要找到通往半径更深处、更靠近中心的区域的路径。"
 },
 {
  "source_id": "9b864cbc52c7c183",
  "zh": "人力资源"
 },
 {
  "source_id": "9c09d835f9b20a52",
  "zh": "茶杯神器"
 },
 {
  "source_id": "9c18450306439659",
  "zh": "高防护、低耐久度的重型头盔。\r\n可与头灯配合使用。"
 },
 {
  "source_id": "9d21111b06b4064b",
  "zh": "此游戏版本不支持你当前的 VR 头显，可能无法正常运行。\r\n为获得最佳体验，请使用 Meta Quest 3/3S 或 Valve Index 设备。"
 },
 {
  "source_id": "9e56e45f314c3b74",
  "zh": "敌人或活跃的危险实体是佩乔尔斯克异常的直接具现，据信拥有一定程度的知觉。它们无一例外地敌视外来者，一经发现便发起攻击。它们能够成群行动，且往往持有武器。其形态差异极大，从人形到抽象形状皆有。\r\n值得注意的是，某些实体会试图模仿人类语言。它们全都无法沟通，且极其致命。\r\n以下列出的是迄今为止发现的异常：\r\n拟态怪——因能复制人类外貌与语言而得名的敌对实体。这些重装人形敌人能够成群组织，进行战术对抗。拟态怪的弹药与护甲可能各不相同。\r\n爬行怪是体型小巧却极为敏捷的生物，以之字形路线移动并高速攻击。\r\n碎片是敌对的人形生物，体内可能含有持久核心；若不将其摧毁，它们就能迅速再生。部分个体拥有会同时造成伤害的爆炸核心。\r\n幻影——使用近距攻击的隐形人形敌人。攻击前会在地面留下痕迹。\r\n方块——无敌且无所不见的敌人，穿行于佩乔尔斯克异常的天空，从远处发动攻击。"
 },
