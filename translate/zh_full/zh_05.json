 },
 {
  "source_id": "93131f11d319b274",
  "zh": "套筒锁定！释放套筒！"
 },
 {
  "source_id": "95a2e8168d41f50b",
  "zh": "向导"
 },
 {
  "source_id": "960d7d0ee0a2825e",
  "zh": "不知道这些房子哪一栋是你祖父母的……每年夏天他们都把你送到这儿来，而你总是不肯在没有我的情况下去。我觉得你妈妈只是装出很烦的样子，其实她并不介意。还记得我们骑着自行车，去尼基塔叔叔的园子里偷苹果吗？我们玩遭遇战、寻宝……我就是在这里遇见尤莉卡的……"
 },
 {
  "source_id": "96cdd2eca90efb4c",
  "zh": "你已经知道，地球上只有一个地方能让你永远藏身。"
 },
 {
  "source_id": "97bfea6a261e3d19",
  "zh": "MP9 弹匣"
 },
 {
  "source_id": "991346e3f2a4791f",
  "zh": "肥皂神器"
 },
 {
  "source_id": "9a49b74de823414a",
  "zh": "我能感觉到它就在附近。让我在地图上标出位置……"
 },
 {
  "source_id": "9aa01d04bab09004",
  "zh": "防御型手榴弹。"
 },
 {
  "source_id": "a0519e66e9aed755",
  "zh": "允许为 AK-74 或 AKM 安装 Bizon、Vityaz、Saiga-12 或 AKS-74U 枪托。"
 },
